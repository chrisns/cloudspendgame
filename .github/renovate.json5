{
  "extends": [
    "github>chrisns/.github:renovate"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "ts-jest@29's peer range is typescript >=4.3 <7; no ts-jest release supports typescript 7 yet"
    },
    {
      "matchPackageNames": ["serverless"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "serverless v4's package/deploy commands always call AWS STS to resolve the account ID, even offline (serverless/serverless#12825), which would require handing AWS credentials to the untrusted PR build job to make CI green"
    }
  ]
}
